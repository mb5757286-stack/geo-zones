<template>
  <div class="page">
    <text class="caption">ЗАПРЕТКА</text>

    <div class="ring {{ringCls}}">
      <text class="status">{{status}}</text>
      <text class="sub">{{sub}}</text>
    </div>

    <div class="card">
      <text class="card-label">Ближайшая зона</text>
      <text class="card-value">{{nearText}}</text>
    </div>

    <text class="info">{{info}}</text>
  </div>
</template>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #000000;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-left: 24px;
    padding-right: 24px;
  }
  .caption {
    font-size: 16px;
    color: #8e8e93;
    letter-spacing: 3px;
  }
  .ring {
    width: 240px;
    height: 240px;
    margin-top: 12px;
    border-radius: 120px;
    border-width: 10px;
    border-style: solid;
    background-color: #1c1c1e;
    justify-content: center;
    align-items: center;
  }
  .ring-wait {
    border-color: #3e8bff;
  }
  .ring-ok {
    border-color: #34c759;
  }
  .ring-warn {
    border-color: #ff9f0a;
    background-color: #3a2a10;
  }
  .ring-bad {
    border-color: #ff453a;
    background-color: #3a1716;
  }
  .status {
    font-size: 40px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
  }
  .sub {
    font-size: 18px;
    color: #d1d1d6;
    margin-top: 6px;
    text-align: center;
  }
  .card {
    width: 100%;
    margin-top: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 24px;
    background-color: #1c1c1e;
    flex-direction: column;
  }
  .card-label {
    font-size: 15px;
    color: #8e8e93;
  }
  .card-value {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 2px;
  }
  .info {
    font-size: 15px;
    color: #636366;
    margin-top: 10px;
    text-align: center;
  }
</style>

<script>
import geolocation from '@system.geolocation'
import vibrator from '@system.vibrator'
import fetch from '@system.fetch'
import storage from '@system.storage'
import BUNDLED from '../common/zones.js'
import geo from '../common/geo.js'
import config from '../common/config.js'

const CACHE_KEY = 'zones_cache_v1'

const REPEAT_MS = 15000   // пока внутри зоны, вибрируем раз в 15 секунд
const WARN_M = 120        // ближе этого расстояния до зоны — предупреждаем заранее

export default {
  private: {
    status: 'Ищу GPS…',
    sub: '',
    info: '',
    ringCls: 'ring-wait',
    zonesText: 'Загрузка…',
    nearText: 'считаю…'
  },

  onInit() {
    this.inside = []
    this.lastBuzz = 0
    this.warned = false
    this.zones = BUNDLED
  },

  onShow() {
    this.loadZones()
    this.startGps()
  },

  // Зоны: сначала из кэша, потом обновляем с сервера (если адрес задан)
  loadZones() {
    try {
      storage.get({
        key: CACHE_KEY,
        default: '',
        success: (data) => {
          try { if (data) this.zones = JSON.parse(data) } catch (err) { /* битый кэш — игнор */ }
        }
      })
    } catch (err) { /* без хранилища — работаем со вшитыми зонами */ }
    if (!config.ZONES_URL) return
    try {
      fetch.fetch({
        url: config.ZONES_URL,
        responseType: 'text',
        success: (ret) => {
          try {
            const list = JSON.parse(ret.data)
            if (!Array.isArray(list)) return
            this.zones = list
            storage.set({ key: CACHE_KEY, value: JSON.stringify(list) })
          } catch (err) { /* ответ не похож на зоны */ }
        },
        fail: () => { /* сети нет — остаются зоны из кэша */ }
      })
    } catch (err) { /* fetch недоступен */ }
  },

  onHide() {
    this.stopGps()
  },

  onDestroy() {
    this.stopGps()
  },

  startGps() {
    try {
      geolocation.subscribe({
        success: (d) => this.onPos(d),
        fail: () => this.gpsFail()
      })
    } catch (err) {
      this.gpsFail()
    }
  },

  stopGps() {
    try {
      geolocation.unsubscribe()
    } catch (err) {
      console.warn('gps stop failed')
    }
  },

  gpsFail() {
    this.status = 'Нет GPS'
    this.sub = 'Включите геолокацию на часах'
    this.ringCls = 'ring-wait'
  },

  onPos(d) {
    const lat = d && d.latitude
    const lon = d && d.longitude
    if (typeof lat !== 'number' || typeof lon !== 'number' || isNaN(lat) || isNaN(lon)) return

    const hit = this.zones.filter(z => geo.inZone(lat, lon, z))
    const near = geo.nearest(lat, lon, this.zones)
    if (hit.length > 0) {
      this.status = 'НЕ ТУДА!'
      this.sub = hit.map(z => z.name).join(', ')
      this.nearText = 'внутри'
      this.ringCls = 'ring-bad'
      const now = Date.now()
      const newlyInside = this.inside.length === 0
      if (newlyInside || now - this.lastBuzz > REPEAT_MS) {
        this.buzz()
        this.lastBuzz = now
      }
      this.inside = hit.map(z => z.name)
      this.warned = true
    } else if (near && near.dist < WARN_M) {
      this.status = 'Рядом зона'
      this.sub = near.name + ' · ' + Math.round(near.dist) + ' м'
      this.nearText = near.name + ' · ' + Math.round(near.dist) + ' м'
      this.ringCls = 'ring-warn'
      this.inside = []
      if (!this.warned) {
        this.warned = true
        this.buzzShort()
      }
    } else {
      this.status = 'Всё ок'
      this.sub = this.zones.length > 0 ? 'Зон на карте: ' + this.zones.length : 'Зон пока нет'
      this.nearText = near ? near.name + ' · ' + this.fmtDist(near.dist) : 'нет зон'
      this.ringCls = 'ring-ok'
      this.inside = []
      this.warned = false
    }
    this.info = lat.toFixed(4) + ', ' + lon.toFixed(4)
  },

  fmtDist(m) {
    return m >= 1000 ? (m / 1000).toFixed(1) + ' км' : Math.round(m) + ' м'
  },

  buzzShort() {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (err) {
      console.warn('vibrate failed')
    }
  },

  // Сильная серия: три длинных импульса подряд
  buzz() {
    for (let i = 0; i < 3; i++) {
      setTimeout(() => {
        try {
          vibrator.vibrate({ mode: 'long' })
        } catch (err) {
          console.warn('vibrate failed')
        }
      }, i * 700)
    }
  }
}
</script>
